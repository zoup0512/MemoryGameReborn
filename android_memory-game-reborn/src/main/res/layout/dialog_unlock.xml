<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView style="@style/AppDialogTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/dg_unlock_title" />
    <TextView android:id="@id/message" style="@style/AppDialogBody"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/dg_unlock_reason" style="@style/AppDialogBody"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="@color/dialog_danger" android:visibility="gone" />
    <Button android:id="@id/ok" style="@style/AppDialogPrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" />
    <Button android:id="@id/cancel" style="@style/AppDialogSecondaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/dg_cancel" />
</LinearLayout>
