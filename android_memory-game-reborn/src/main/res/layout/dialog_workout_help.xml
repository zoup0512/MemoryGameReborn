<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView style="@style/AppDialogTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/dg_workout_help_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/dg_workout_intro" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:textStyle="bold" android:text="@string/dg_workout_games_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/dg_workout_games_body" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:textStyle="bold" android:text="@string/dg_workout_calendar_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/dg_workout_calendar_body" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:textStyle="bold" android:text="@string/dg_workout_level_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/dg_workout_level_body" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:textStyle="bold" android:text="@string/dg_workout_points_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/dg_workout_points_body" />
    <Button android:id="@id/close" style="@style/AppDialogPrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/dg_got_it" />
</LinearLayout>
