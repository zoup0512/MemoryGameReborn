<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/root" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@id/title" style="@style/AppDialogTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dg_pause_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/dg_pause_body" />
    <LinearLayout android:id="@id/panel_pause" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:layout_marginTop="16dp" android:padding="8dp"
        android:gravity="center_vertical" android:clickable="true" android:focusable="true"
        android:background="@drawable/dialog_secondary_button">
        <TextView android:id="@+id/dg_sound_label" style="@style/AppDialogBody"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:importantForAccessibility="no" android:text="@string/dg_sound_on" />
        <ToggleButton android:id="@id/sound" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/button_sounds_on_off" android:clickable="false"
            android:focusable="false" android:importantForAccessibility="no"
            android:textOn="" android:textOff="" android:text="" />
    </LinearLayout>
    <FrameLayout android:id="@id/resumeContainer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="48dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/dialog_primary_button">
        <TextView android:id="@id/resumeButton" style="@style/AppDialogPrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@null" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" android:text="@string/dg_resume" />
    </FrameLayout>
    <FrameLayout android:id="@id/replayContainer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/dialog_secondary_button">
        <TextView android:id="@id/replayButton" style="@style/AppDialogSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@null" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" android:text="@string/dg_restart_game" />
    </FrameLayout>
    <FrameLayout android:id="@id/tutorialContainer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/dialog_secondary_button">
        <TextView android:id="@id/tutorialButton" style="@style/AppDialogSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@null" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" android:text="@string/dg_tutorial" />
    </FrameLayout>
    <FrameLayout android:id="@id/exitContainer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp"
        android:clickable="true" android:focusable="true">
        <TextView android:id="@id/exitButton" style="@style/AppDialogTextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/dialog_danger" android:clickable="false" android:focusable="false" android:importantForAccessibility="no"
            android:text="@string/dg_end_game" />
    </FrameLayout>
</LinearLayout>
