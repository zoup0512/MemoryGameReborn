<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/dialog_content" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView style="@style/AppDialogTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/dg_fail_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dg_fail_body" />
    <TextView android:id="@id/buyText" style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/dg_balance" style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/dg_continue_reason" style="@style/AppDialogBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/dialog_text_secondary" />
    <Button android:id="@id/buyImage" style="@style/AppDialogPrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/dg_continue_paid" />
    <LinearLayout android:id="@id/restartContainer" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@id/restartImage" style="@style/AppDialogSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/dg_restart_game" />
    </LinearLayout>
    <Button android:id="@+id/dg_end_game" style="@style/AppDialogTextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/dialog_danger" android:text="@string/dg_end_game" />
</LinearLayout>
