<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/dialog_content" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/dialog_text_secondary"
        android:text="@string/dg_challenge_title" />
    <TextView android:id="@id/gameName" style="@style/AppDialogTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <TextView android:id="@id/score" style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <FrameLayout android:id="@id/previewBackground" android:layout_width="match_parent"
        android:layout_height="128dp" android:layout_marginTop="16dp">
        <ImageView android:id="@id/image" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginBottom="4dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <View android:id="@id/categoryColorView" android:layout_width="match_parent"
            android:layout_height="4dp" android:layout_gravity="bottom" android:importantForAccessibility="no" />
    </FrameLayout>
    <Button android:id="@id/play" style="@style/AppDialogPrimaryButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/dg_challenge_play" />
    <Button android:id="@id/tutorial" style="@style/AppDialogSecondaryButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dg_tutorial" />
    <Button android:id="@+id/dg_challenge_cancel" style="@style/AppDialogTextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/dg_not_now" />
</LinearLayout>
