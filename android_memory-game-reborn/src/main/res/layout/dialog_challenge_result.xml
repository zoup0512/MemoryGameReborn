<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/dialog_content" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dg_challenge_result_title" android:textColor="@color/dialog_text_secondary" />
    <TextView android:id="@id/gameName" style="@style/AppDialogTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <TextView android:id="@id/score" style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/dg_challenge_goal" style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" />
    <TextView android:id="@+id/dg_challenge_difference" style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" />
    <LinearLayout android:orientation="horizontal" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:importantForAccessibility="noHideDescendants">
        <ImageView android:id="@id/star1" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_margin="4dp" android:tint="@color/dialog_primary" app:srcCompat="@drawable/ic_star" />
        <ImageView android:id="@id/star2" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_margin="4dp" android:tint="@color/dialog_primary" app:srcCompat="@drawable/ic_star" />
        <ImageView android:id="@id/star3" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_margin="4dp" android:tint="@color/dialog_primary" app:srcCompat="@drawable/ic_star" />
    </LinearLayout>
    <TextView android:id="@+id/dg_challenge_stars" style="@style/AppDialogBody"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" />
    <Button android:id="@id/next" style="@style/AppDialogPrimaryButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/dg_challenge_next" />
    <Button android:id="@id/home" style="@style/AppDialogSecondaryButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dg_challenge_home" />
</LinearLayout>
