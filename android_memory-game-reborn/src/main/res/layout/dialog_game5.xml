<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Keep the legacy ID/binding, but this is a sound control, not pause. -->
    <Button
        android:id="@id/panel_pause"
        style="@style/AppDialogSecondaryButton"
        android:layout_marginBottom="16dp"
        android:drawableLeft="@android:drawable/ic_lock_silent_mode_off"
        android:drawablePadding="8dp"
        android:text="@string/count_sound_on"
        android:contentDescription="@string/count_sound_on_action" />

    <TextView
        android:id="@id/title"
        style="@style/AppDialogTitle"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:text="@string/game5_dialog_text" />

    <TextView
        android:id="@+id/count_answer_feedback"
        style="@style/AppDialogBody"
        android:gravity="center"
        android:minHeight="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/count_choose_answer" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">
        <Button
            android:id="@id/button_dialog_game5_cell_count_1"
            style="@style/AppDialogSecondaryButton"
            android:layout_width="@dimen/count_button_size"
            android:layout_height="@dimen/count_button_size"
            android:layout_margin="@dimen/padding_xsmall"
            android:padding="4dp"
            android:textSize="28sp" />
        <Button
            android:id="@id/button_dialog_game5_cell_count_2"
            style="@style/AppDialogSecondaryButton"
            android:layout_width="@dimen/count_button_size"
            android:layout_height="@dimen/count_button_size"
            android:layout_margin="@dimen/padding_xsmall"
            android:padding="4dp"
            android:textSize="28sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">
        <Button
            android:id="@id/button_dialog_game5_cell_count_3"
            style="@style/AppDialogSecondaryButton"
            android:layout_width="@dimen/count_button_size"
            android:layout_height="@dimen/count_button_size"
            android:layout_margin="@dimen/padding_xsmall"
            android:padding="4dp"
            android:textSize="28sp" />
        <Button
            android:id="@id/button_dialog_game5_cell_count_4"
            style="@style/AppDialogSecondaryButton"
            android:layout_width="@dimen/count_button_size"
            android:layout_height="@dimen/count_button_size"
            android:layout_margin="@dimen/padding_xsmall"
            android:padding="4dp"
            android:textSize="28sp" />
    </LinearLayout>
</LinearLayout>
