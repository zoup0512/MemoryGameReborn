<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/online_page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/panel_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/online_toolbar_height"
        android:background="@color/online_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/online_page_padding">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/online_toolbar_height"
            android:layout_height="@dimen/online_toolbar_height"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_white"
            app:tint="@color/online_text_primary" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/get_ready"
            android:textColor="@color/online_text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/online_page_padding"
        android:layout_marginTop="@dimen/online_card_gap"
        android:layout_marginEnd="@dimen/online_page_padding"
        android:layout_marginBottom="@dimen/online_card_gap"
        android:layout_weight="1"
        android:background="@drawable/online_card_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingTop="@dimen/online_card_padding">

        <TextView
            android:id="@+id/txt_start_game_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.08"
            android:maxLines="3"
            android:minHeight="64dp"
            android:paddingStart="@dimen/online_card_padding"
            android:paddingEnd="@dimen/online_card_padding"
            android:textColor="@color/online_text_primary"
            android:textSize="18sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.cube.memorygames.ui.NonSwipeableViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </FrameLayout>

        <com.viewpagerindicator.CirclePageIndicator
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="20dp"
            app:centered="true"
            app:fillColor="@color/online_primary"
            app:pageColor="@color/online_divider"
            app:radius="4dp"
            app:strokeColor="@color/online_divider"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/online_divider" />

    <FrameLayout
        android:id="@+id/skip_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/online_surface"
        android:minHeight="76dp"
        android:paddingStart="@dimen/online_page_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/online_page_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/text_skip_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/online_button_height"
            android:layout_gravity="center"
            android:background="@drawable/online_primary_button"
            android:gravity="center"
            android:text="@string/skip"
            android:textColor="@android:color/white"
            android:textSize="17sp" />
    </FrameLayout>
</LinearLayout>
