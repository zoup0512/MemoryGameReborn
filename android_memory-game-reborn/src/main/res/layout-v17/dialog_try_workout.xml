<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView style="@style/AppDialogTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/dg_workout_title" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/dg_workout_intro" />
    <Button android:id="@id/dialog_try_workout_confirm_button" style="@style/AppDialogPrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/dg_workout_open" />
    <Button android:id="@id/dialog_try_workout_cancel_button" style="@style/AppDialogSecondaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/dg_not_now" />
    <Button android:id="@+id/dg_workout_never" style="@style/AppDialogTextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/dg_workout_never" />
</LinearLayout>
