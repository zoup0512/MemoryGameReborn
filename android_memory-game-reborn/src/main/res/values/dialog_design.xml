<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="dialog_surface">#FFFFFFFF</color>
    <color name="dialog_text">#FF182230</color>
    <color name="dialog_text_secondary">#FF596579</color>
    <color name="dialog_primary">#FF087CAF</color>
    <color name="dialog_primary_pressed">#FF06628C</color>
    <color name="dialog_danger">#FFBD3045</color>
    <color name="dialog_border">#FFD8E3ED</color>
    <color name="dialog_disabled_surface">#FFE1EAF2</color>
    <color name="dialog_disabled_text">#FF596579</color>
    <style name="AppDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="colorAccent">@color/dialog_primary</item>
        <item name="android:colorAccent">@color/dialog_primary</item>
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="android:textColorSecondary">@color/dialog_text_secondary</item>
    </style>
    <style name="AppAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="colorAccent">@color/dialog_primary</item>
        <item name="android:colorAccent">@color/dialog_primary</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="android:textColorSecondary">@color/dialog_text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogAlertPrimaryButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogAlertSecondaryButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppDialogAlertSecondaryButton</item>
    </style>
    <style name="AppDialogTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/dialog_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="AppDialogBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/dialog_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="AppDialogPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/dialog_primary_text</item>
        <item name="android:background">@drawable/dialog_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="AppDialogSecondaryButton" parent="AppDialogPrimaryButton">
        <item name="android:textColor">@color/dialog_secondary_text</item>
        <item name="android:background">@drawable/dialog_secondary_button</item>
    </style>
    <style name="AppDialogTextButton" parent="AppDialogSecondaryButton">
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="AppDialogAlertPrimaryButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_primary</item>
    </style>
    <style name="AppDialogAlertSecondaryButton" parent="AppDialogAlertPrimaryButton">
        <item name="android:textColor">@color/dialog_text_secondary</item>
    </style>
</resources>
