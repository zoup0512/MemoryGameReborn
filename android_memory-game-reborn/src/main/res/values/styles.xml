<resources>
    <style name="BB_BottomBarBadge_Text" parent="@style/TextAppearance.AppCompat.Body2">
        <item name="android:textColor">#ffffffff</item>
    </style>
    <style name="BB_BottomBarItem_Fixed.TitleAppearance" parent="@style/TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14.0sp</item>
    </style>
    <style name="BB_BottomBarItem_Shifting.TitleAppearance" parent="@style/BB_BottomBarItem_Fixed.TitleAppearance">
        <item name="android:textColor">#ffffffff</item>
    </style>
    <style name="BB_BottomBarItem_Tablet">
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="BB_BottomBarItem_TitleStyle">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="GdxThemeBase" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="dialogTheme">@style/AppDialogTheme</item>
        <item name="colorAccent">@color/dialog_primary</item>
        <item name="android:colorAccent">@color/dialog_primary</item>
    </style>
    <style name="GdxTheme" parent="@style/GdxThemeBase" />
    <style name="SplashTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="TextColor">
        <item name="android:textColor">#ff000000</item>
    </style>
    <style name="WinDialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
    </resources>