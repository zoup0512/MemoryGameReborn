<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/root" android:orientation="vertical" android:gravity="center_horizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@id/title" style="@style/AppDialogTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="@string/dg_trophy_title" />
    <TextView android:id="@id/subTitle" style="@style/AppDialogBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:layout_marginTop="8dp" />
    <ImageView android:id="@id/cupImage" android:layout_width="144dp" android:layout_height="144dp"
        android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/dg_achievement_level" style="@style/AppDialogBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:visibility="gone" />
    <TextView style="@style/AppDialogBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="center" android:textColor="@color/dialog_text_secondary"
        android:text="@string/dg_trophy_continue_hint" />
    <Button android:id="@id/continueButton" style="@style/AppDialogPrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/dg_continue" />
</LinearLayout>
