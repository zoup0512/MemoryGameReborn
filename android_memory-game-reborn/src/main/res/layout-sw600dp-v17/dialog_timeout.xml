<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/dialog_content" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@id/fail_dialog_title" style="@style/AppDialogTitle"
        android:text="@string/dialog_timeout_title" />
    <TextView android:id="@+id/dialog_result_level" style="@style/AppDialogTitle"
        android:layout_marginTop="20dp" android:textColor="@color/dialog_primary" />
    <TextView android:id="@+id/dialog_result_best" style="@style/AppDialogBody"
        android:layout_marginTop="6dp" />
    <TextView android:id="@id/fail_dialog_restart_title" style="@style/AppDialogBody"
        android:visibility="gone" android:text="@string/restart_game" />
    <Button android:id="@id/button_dialog_fail_retry" style="@style/AppDialogPrimaryButton"
        android:layout_marginTop="24dp" android:text="@string/dialog_result_replay" />
    <Button android:id="@id/mainMenu" style="@style/AppDialogSecondaryButton"
        android:layout_marginTop="10dp" android:text="@string/dialog_result_menu" />
    <LinearLayout android:id="@id/fail_dialog_game_suggestion_container"
        android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp">
        <TextView android:id="@id/fail_dialog_inner_title" style="@style/AppDialogBody"
            android:text="@string/dialog_result_suggestion" />
        <ImageButton android:id="@id/fail_dialog_game_suggestion_image"
            android:layout_width="match_parent" android:layout_height="112dp"
            android:layout_marginTop="8dp" android:background="@drawable/dialog_secondary_button"
            android:padding="8dp" android:scaleType="fitCenter"
            android:contentDescription="@string/dialog_result_suggestion" />
        <TextView android:id="@id/fail_dialog_game_suggestion_game_name" style="@style/AppDialogBody"
            android:gravity="center" android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
