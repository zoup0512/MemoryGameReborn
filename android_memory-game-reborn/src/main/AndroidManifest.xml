        <activity
            android:name="com.cube.memorygames.games.Game22MirrorsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game23TableActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />

        <!-- Local gameplay reminders (AlarmManager based, no network). -->
        <receiver
            android:name="com.cube.memorygames.NotificationBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cube.memorygames.ACTION_CANCEL" />
                <action android:name="com.cube.memorygames.ACTION_PLAY" />
                <action android:name="com.cube.memorygames.ACTION_PLAY_REMINDER" />
                <action android:name="com.cube.memorygames.ACTION_VIEW" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.cube.memorygames.reminder.ReminderBroadcastReceiver"
            android:enabled="true" />

        <receiver
            android:name="com.cube.memorygames.reminder.DeviceBootReceiver"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
