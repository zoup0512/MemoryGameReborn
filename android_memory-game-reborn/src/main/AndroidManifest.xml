<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online PK mode (docs/online-pk-prd.md): WebSocket connection to the PK
         server only. No billing, push or location permissions. Single-player
         modes still work fully offline; the Online tab degrades gracefully. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="com.cube.memorygames.MemoryApplicationModel"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/GdxTheme">

        <provider
            android:name="com.activeandroid.content.ContentProvider"
            android:authorities="com.memory.brain.training.games"
            android:exported="false" />

        <meta-data
            android:name="AA_DB_NAME"
            android:value="memorygames.db" />
        <meta-data
            android:name="AA_DB_VERSION"
            android:value="16" />

        <activity
            android:name="com.cube.memorygames.SplashActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.cube.memorygames.MainMenuActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.cube.memorygames.StartGameActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.cube.memorygames.api.online.OnlineHistoryActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.api.online.OnlineTopActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.activity.OnlineTutorialActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.cube.memorygames.activity.OnlineGameTutorialActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.cube.memorygames.api.online.OnlineMatchActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.cube.memorygames.TrophiesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.cube.memorygames.games.Game1MemoryGridActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game2RotatingGridActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game3HexagonsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game4WhoNewActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game5CountAllActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game6FollowThePathActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game7ImageVortexActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.cube.memorygames.games.Game8CatchThemActivity"
