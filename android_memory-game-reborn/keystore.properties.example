# Release signing for the Android client (consumed by build.gradle and
# build-release.bat; design: ../docs/android-client-hardening-design.md 3.3).
#
# 用法：把本文件复制成同目录下的 keystore.properties，填入真实值。
#   - keystore.properties 已在 .gitignore 中，不会入库；不要提交它。
#   - 文件保存为 UTF-8（构建按 UTF-8 读取，路径可用中文）。
#   - 路径用正斜杠，或把反斜杠写成双写（Properties 文件里单反斜杠是转义符，
#     "C:\keys\x.jks" 会被解析成 "C:keysx.jks"）。
#
# 填好后一键出签名包：
#   build-release.bat
# 只打印证书指纹（用于登记）：
#   gradlew printReleaseCertSha256

# 绝对路径，或相对本模块目录的相对路径
storeFile=D:/keys/memorygame-release.jks
storePassword=
keyAlias=
# 留空则与 storePassword 相同
keyPassword=
# jks 或 pkcs12；旧 .jks 文件必须写 jks，新版 keytool 生成的默认是 pkcs12
storeType=pkcs12
