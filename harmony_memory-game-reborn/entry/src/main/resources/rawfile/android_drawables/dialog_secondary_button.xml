<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/dialog_disabled_surface" /><corners android:radius="12dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/online_primary_soft" /><stroke android:width="1dp" android:color="@color/dialog_primary" /><corners android:radius="12dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/online_primary_soft" /><stroke android:width="2dp" android:color="@color/dialog_primary" /><corners android:radius="12dp" /></shape></item>
    <item><shape><solid android:color="@color/dialog_surface" /><stroke android:width="1dp" android:color="@color/dialog_border" /><corners android:radius="12dp" /></shape></item>
</selector>
